        <a href="[% help_url | html %]/help/contact.html">Contact</a> <span class="ds-site-footer-sep" aria-hidden="true">&middot;</span>
        <a href="[% help_url | html %]/help/subscribe">Subscribe</a> <span class="ds-site-footer-sep" aria-hidden="true">&middot;</span>
        <a href="[% help_url | html %]/help/license/index.html">Copyright</a> <span class="ds-site-footer-sep" aria-hidden="true">&middot;</span>
        <a href="[% help_url | html %]/help/policies/privacy_policy.html">Privacy</a> <span class="ds-site-footer-sep" aria-hidden="true">&middot;</span>
        <a href="[% help_url | html %]/help/web_accessibility.html">Accessibility</a> <span class="ds-site-footer-sep" aria-hidden="true">&middot;</span>
        <a href="https://status.arxiv.org/" target="_blank" rel="noopener noreferrer">Operational Status<span class="is-sr-only"> (opens in new tab)</span></a>
      </nav>
    </div>
    <div class="ds-site-footer-funders">

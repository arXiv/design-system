{
  "name": "@arxiv/brand-templates",
  "version": "0.1.0",
  "description": "arXiv brand head/header/footer as React components, generated from the design system's portable-Jinja templates. Install by git SHA: the same SHA Python consumers pin. GENERATED by templates/generate.py.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "files": [
    "templates/adapters/react/*.jsx",
    "templates/adapters/react/*.d.ts"
  ],
  "exports": {
    "./Head": {
      "types": "./templates/adapters/react/Head.d.ts",
      "default": "./templates/adapters/react/Head.jsx"
    },
    "./Header": {
      "types": "./templates/adapters/react/Header.d.ts",
      "default": "./templates/adapters/react/Header.jsx"
    },
    "./Footer": {
      "types": "./templates/adapters/react/Footer.d.ts",
      "default": "./templates/adapters/react/Footer.jsx"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
